# Backend environment configuration
# NEVER commit real values. Real secrets are entered at runtime via secure fields only.

# MongoDB connection (Emergent provided this; supply your own mongo connection string)
MONGO_URL=<mongo connection string>
DB_NAME=hermes_desk

# CORS: comma-separated exact browser origins for split development only.
# Never use * with credentialed cookies. Production serves the frontend same-origin and needs no CORS entry.
CORS_ORIGINS=http://localhost:3000

# Hermes upstream dashboard (non-secret)
HERMES_DASHBOARD_URL=https://hermes2.sanctrastudy.live

# Crypto keys for upstream session handling (generate locally, keep secret)
# AURA_UPSTREAM_KEY = a Fernet key (urlsafe base64, 32 bytes). Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AURA_UPSTREAM_KEY=<fernet key - keep secret>
# AURA_SESSION_PEPPER = any high-entropy random string
AURA_SESSION_PEPPER=<random secret string>
